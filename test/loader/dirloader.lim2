; ==============================================================================
; ПРЯМОЙ ПОБАЙТОВЫЙ ЗАГРУЗЧИК (с учетом аппаратной пары регистров)
; Источник A:   $1 (старший байт), $2 (младшие 16 бит)
; Назначение B: $ptreg (с аппаратным автоинкрементом)
; Размер:       $4 (число байт)
; ==============================================================================

; ==============================================================================
; ПРЯМОЙ ПОБАЙТОВЫЙ ЗАГРУЗЧИК (с учетом аппаратной пары регистров)
; Источник A:   $1 (старший байт), $2 (младшие 16 бит)
; Назначение B: $ptreg (с аппаратным автоинкрементом)
; Размер:       $4 (число байт)
; ==============================================================================

.org 0x00000000

_start:
    LMR.b $1, 0x0000            ; Старший сегмент адреса A
    LMR.w $2, 0x0000            ; Младший адрес источника A
    MSP.ld $ptreg, 0x100000     ; Адрес назначения B
    LMR.w $4, prog_size         ; Размер (256 байт)

    CALL direct_loader
    JMP 0x100000

direct_loader:
    LMR.w $5, 0
    JCR $4 == $5, loader_done

loader_loop:
    LRR $0, $1
    LMR.b $0, [$0, $2]
    LRM.b $0, [$ptreg]
    INC $2
    DEC $4
    JCR $4 > $5, loader_loop

loader_done:
    RET

prog_size = $ - $$